<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MIST Blood Connect | Saving Lives</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        html { scroll-behavior: smooth; }
        .hide-scroll::-webkit-scrollbar { display: none; }
        .hide-scroll { -ms-overflow-style: none; scrollbar-width: none; }
        .blessing-card { background-image: url('https://www.transparenttextures.com/patterns/cream-paper.png'); }
        
        /* Ticker & Animations */
        .ticker-wrap { width: 100%; overflow: hidden; white-space: nowrap; }
        .ticker { display: inline-block; padding-left: 100%; animation: ticker 40s linear infinite; }
        @keyframes ticker { 0% { transform: translate3d(0, 0, 0); } 100% { transform: translate3d(-100%, 0, 0); } }
        .timeline-container { border-left: 2px solid #fca5a5; position: relative; margin-left: 1rem; }
        .timeline-item::before { content: ''; position: absolute; left: -1.4rem; top: 0.25rem; width: 1rem; height: 1rem; background-color: #ef4444; border-radius: 50%; border: 3px solid #fee2e2; box-shadow: 0 0 0 2px #ef4444; }
        
        /* Social Media Frame overlay */
        .profile-frame { background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="150" height="150"><circle cx="75" cy="75" r="70" fill="none" stroke="%23EF4444" stroke-width="6" stroke-dasharray="10 5"/><text x="50%" y="90%" text-anchor="middle" fill="%23EF4444" font-size="12" font-family="Arial" font-weight="bold">MIST BLOOD DONOR</text></svg>'); background-size: cover; }
        .toggle-checkbox:checked { right: 0; border-color: #ef4444; }
        .toggle-checkbox:checked + .toggle-label { background-color: #ef4444; }
        .wave-bg { background: linear-gradient(120deg, #eff6ff, #dbeafe, #bfdbfe); background-size: 200% 200%; animation: wave 4s ease infinite; }
        @keyframes wave { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
        
        /* FAQ & Routing */
        .faq-answer { display: none; }
        .faq-answer.open { display: block; animation: slideDown 0.3s ease-in-out; }
        .rotate-180 { transform: rotate(180deg); }
        @keyframes slideDown { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
        .zigzag-row:nth-child(even) { flex-direction: row-reverse; }
        
        /* SPA Navigation */
        .page { display: none; opacity: 0; transition: opacity 0.3s ease; }
        .page.active { display: block; opacity: 1; }
        .legal-content p, .legal-content li { color: #4b5563; font-size: 1rem; line-height: 1.75; margin-bottom: 0.75rem; }
        .legal-content ul { list-style-type: disc; padding-left: 1.5rem; margin-bottom: 1.5rem; }
        .legal-content h4 { color: #111827; font-size: 1.125rem; font-weight: 700; margin-top: 1.5rem; margin-bottom: 0.5rem; }
    </style>
</head>
<body class="bg-gray-50 font-sans text-gray-800 flex flex-col min-h-screen">

    <!-- Global Navigation -->
    <div class="bg-indigo-900 text-white text-center py-1.5 text-xs font-bold tracking-wide">
        <i class="fas fa-bolt text-yellow-400 mr-1"></i> This month's Blood Drive is proudly powered by <span class="text-yellow-300">Atomize Classroom</span>
    </div>
    <nav class="bg-red-700 text-white shadow-lg sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-3 flex flex-col md:flex-row justify-between items-center gap-3">
            <div class="flex items-center gap-2 cursor-pointer" onclick="nav('home')">
                <i class="fas fa-droplet text-2xl"></i>
                <h1 class="text-xl font-bold tracking-wide">MIST Blood Connect</h1>
            </div>
            <!-- Ordered Menu -->
            <div class="flex items-center gap-4 text-sm md:text-base flex-wrap justify-center">
                <button onclick="nav('home')" class="hover:text-red-200 font-semibold transition">Home</button>
                <button onclick="nav('support')" class="hover:text-red-200 font-semibold transition">Help center</button>
                <button onclick="nav('about')" class="hover:text-red-200 font-semibold transition">About us</button>
                <button onclick="nav('portal')" class="hover:text-red-200 font-semibold transition">My Profile</button>
                <span class="text-red-400 hidden lg:inline">|</span>
                <button onclick="toggleModal('fundModal')" class="text-yellow-300 hover:text-yellow-100 font-bold transition hidden lg:block"><i class="fas fa-hand-holding-heart"></i> Fund</button>
                <button onclick="toggleModal('registerModal')" class="hover:text-red-200 font-semibold transition hidden lg:block">Register</button>
                <button onclick="toggleModal('postModal')" class="bg-white text-red-700 px-3 py-1.5 rounded-md font-bold shadow hover:bg-gray-100 transition hidden lg:block"><i class="fas fa-bullhorn"></i> Request Blood</button>
            </div>
        </div>
    </nav>

    <!-- SPA PAGES CONTAINER -->
    <div id="app-container" class="flex-grow flex flex-col">

        <!-- ================= PAGE 1: HOME ================= -->
        <div id="home" class="page active flex-grow flex flex-col">
            <div class="ticker-wrap bg-red-50 border-b border-red-100 py-2 text-red-800 text-sm font-semibold">
                <div class="ticker">
                    <span class="mx-8"><i class="fas fa-heart text-red-500 mr-1"></i> An NSE student just donated for a CE student's mother!</span>
                    <span class="mx-8"><i class="fas fa-heart text-red-500 mr-1"></i> Akib donated A+ blood today in memory of his grandfather.</span>
                    <span class="mx-8"><i class="fas fa-heart text-red-500 mr-1"></i> A CE student stepped up for a midnight emergency at DMCH. We salute the unity!</span>
                </div>
            </div>

            <header class="bg-white border-b relative overflow-hidden pb-8">
                <div class="max-w-7xl mx-auto px-4 pt-8 text-center">
                    <h2 class="text-3xl md:text-5xl font-extrabold text-gray-900 mb-4">Donate Blood, Save a <span class="text-red-600">Life</span></h2>
                    <p class="text-lg text-gray-600 max-w-2xl mx-auto mb-10">A single drop of your blood can give someone a second chance at life.</p>
                    
                    <div id="heroScroll" class="flex overflow-x-auto gap-6 pb-6 hide-scroll max-w-6xl mx-auto px-4 items-stretch cursor-pointer">
                        <div class="shrink-0 w-80 bg-gradient-to-br from-red-50 to-white border border-red-100 p-5 rounded-2xl relative shadow-sm text-left flex flex-col justify-center transform transition hover:scale-105">
                            <div class="absolute top-0 right-0 bg-red-600 text-white text-[10px] font-bold px-3 py-1 rounded-bl-lg uppercase"><i class="fas fa-star text-yellow-300"></i> Today's Hero</div>
                            <div class="flex items-center gap-4 mt-2">
                                <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-1.2.1&auto=format&fit=crop&w=150&q=80" class="w-14 h-14 rounded-full border-2 border-red-500 object-cover">
                                <div><h3 class="font-bold text-gray-900">Akib Ahmed <span class="text-gray-500 text-xs font-normal">(NSE-10)</span></h3></div>
                            </div>
                            <p class="text-gray-700 text-sm mt-3 font-medium italic">"Akib saves Rakib's mother by donating blood today at CMH. We salute you!"</p>
                        </div>
                        <div class="shrink-0 w-80 bg-gradient-to-br from-green-50 to-white border border-green-100 p-5 rounded-2xl relative shadow-sm text-left flex flex-col justify-center transform transition hover:scale-105">
                            <div class="absolute top-0 right-0 bg-green-600 text-white text-[10px] font-bold px-3 py-1 rounded-bl-lg uppercase"><i class="fas fa-seedling text-green-200"></i> First Time Donor</div>
                            <div class="flex items-center gap-4 mt-2">
                                <div class="w-14 h-14 bg-green-200 text-green-700 rounded-full flex items-center justify-center text-xl font-black border-2 border-green-400">A</div>
                                <div><h3 class="font-bold text-gray-900">Antor Das <span class="text-gray-500 text-xs font-normal">(CSE-22)</span></h3></div>
                            </div>
                            <p class="text-gray-700 text-sm mt-3 font-medium italic">"Welcome to our community! Antor ajk 1st time Blood dise. A true inspiration."</p>
                        </div>
                        <div class="shrink-0 w-80 bg-gradient-to-br from-blue-50 to-white border border-blue-100 p-5 rounded-2xl relative shadow-sm text-left flex flex-col justify-center transform transition hover:scale-105">
                            <div class="absolute top-0 right-0 bg-blue-600 text-white text-[10px] font-bold px-3 py-1 rounded-bl-lg uppercase"><i class="fas fa-birthday-cake text-pink-300"></i> Birthday Wish</div>
                            <div class="flex items-center gap-4 mt-2">
                                <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?ixlib=rb-1.2.1&auto=format&fit=crop&w=150&q=80" class="w-14 h-14 rounded-full border-2 border-blue-500 object-cover">
                                <div><h3 class="font-bold text-gray-900">Amlan <span class="text-gray-500 text-xs font-normal">(ME-19)</span></h3></div>
                            </div>
                            <p class="text-gray-700 text-sm mt-3 font-medium italic">"Happy Birthday to our Blood Hero Amlan! Wishing you endless joy and blessings."</p>
                        </div>
                        <div class="shrink-0 w-80 bg-gradient-to-br from-purple-50 to-white border border-purple-100 p-5 rounded-2xl relative shadow-sm flex flex-col justify-center items-center transform transition hover:scale-105">
                            <div class="absolute top-0 right-0 bg-purple-600 text-white text-[10px] font-bold px-3 py-1 rounded-bl-lg uppercase">Aug 2026</div>
                            <div class="w-14 h-14 bg-purple-100 text-purple-600 rounded-full flex items-center justify-center text-2xl mb-2"><i class="fas fa-trophy"></i></div>
                            <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wide">Dept of the Month</h3>
                            <p class="text-purple-800 font-black text-lg text-center mt-1">Nuclear Science & Eng.</p>
                        </div>
                    </div>

                    <div class="max-w-4xl mx-auto mt-4 px-4">
                        <div class="bg-gray-800 p-3 rounded-t-lg text-white font-bold text-left flex items-center gap-2"><i class="fas fa-search text-red-400"></i> Find a Donor Instantly</div>
                        <div class="bg-white p-4 rounded-b-lg shadow-lg border border-gray-200">
                            <div class="flex flex-col md:flex-row gap-2">
                                <select id="searchGroup" class="flex-1 p-3 rounded border focus:outline-red-500 text-lg font-semibold bg-gray-50">
                                    <option value="">Select Blood Group...</option><option value="A+">A+ (A Positive)</option><option value="B+">B+ (B Positive)</option><option value="O+">O+ (O Positive)</option><option value="AB+">AB+ (AB Positive)</option><option value="A-">A- (A Negative)</option><option value="B-">B- (B Negative)</option><option value="O-">O- (O Negative)</option><option value="AB-">AB- (AB Negative)</option>
                                </select>
                                <button onclick="searchDonors()" class="bg-red-600 text-white px-8 py-3 rounded hover:bg-red-700 transition font-bold text-lg">Search</button>
                            </div>
                            <div id="searchResults" class="hidden mt-4 bg-gray-50 p-4 rounded-lg border border-gray-200">
                                <h4 class="font-bold text-gray-800 mb-3 flex justify-between items-center border-b pb-2"><span id="searchResultTitle">Available Donors</span><button onclick="closeSearch('searchResults')" class="text-gray-400 hover:text-red-500"><i class="fas fa-times"></i></button></h4>
                                <ul class="space-y-2 max-h-60 overflow-y-auto hide-scroll" id="donorList"></ul>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <div class="max-w-7xl mx-auto px-4 py-10 grid grid-cols-1 lg:grid-cols-3 gap-8 flex-grow w-full">
                <div class="lg:col-span-2 space-y-10">
                    <div>
                        <div class="flex justify-between items-center mb-6 border-b pb-2">
                            <h3 class="text-2xl font-bold text-gray-800 border-l-4 border-red-600 pl-3">Live Blood Requests</h3>
                            <span class="bg-red-100 text-red-600 text-xs font-bold px-2 py-1 rounded animate-pulse"><i class="fas fa-circle text-[8px] mr-1"></i> Live</span>
                        </div>
                        <div id="feedContainer" class="space-y-5"></div>
                    </div>
                    <div>
                        <h3 class="text-2xl font-bold text-gray-800 border-l-4 border-pink-500 pl-3 mb-6">Wall of Gratitude</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="blessing-card bg-pink-50 p-5 rounded-lg shadow-sm border border-pink-100">
                                <i class="fas fa-quote-left text-pink-300 text-2xl mb-2"></i>
                                <p class="text-gray-700 text-sm font-medium italic">"আমার মায়ের সিজারের সময় রক্তের খুব প্রয়োজন ছিল। MIST-এর এক ভাই এসে রক্ত দিয়ে জীবন বাঁচিয়েছেন। আল্লাহ আপনার মঙ্গল করুক।"</p>
                                <p class="text-right text-xs text-pink-600 font-bold mt-3">- Anonymous Blessing</p>
                            </div>
                            <div class="blessing-card bg-yellow-50 p-5 rounded-lg shadow-sm border border-yellow-100">
                                <i class="fas fa-quote-left text-yellow-300 text-2xl mb-2"></i>
                                <p class="text-gray-700 text-sm font-medium italic">"I was so panicked when my father needed O- blood. The Rare Heroes club saved us. I will never forget this help."</p>
                                <p class="text-right text-xs text-yellow-600 font-bold mt-3">- Patient's Daughter</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="space-y-6">
                    <div class="bg-orange-100 border border-orange-300 p-5 rounded-xl shadow-sm relative overflow-hidden">
                        <div class="absolute -right-4 -top-4 opacity-10 text-orange-500 text-7xl"><i class="fas fa-mosquito"></i></div>
                        <h4 class="font-bold text-orange-900 mb-1"><i class="fas fa-exclamation-triangle mr-1"></i> Dengue Alert Mode</h4>
                        <p class="text-xs text-orange-800 font-semibold mb-3">High demand for Platelets in Dhaka!</p>
                        <button onclick="toggleModal('plateletModal')" class="w-full bg-orange-600 text-white text-sm font-bold py-2 rounded hover:bg-orange-700 shadow-md">Join Apheresis (Platelet) Team</button>
                    </div>
                    <div class="bg-gray-900 text-white p-5 rounded-xl shadow-sm border border-gray-700">
                        <h4 class="font-bold text-gray-100 mb-2"><i class="fas fa-gem text-blue-400 mr-2"></i> The Rare Heroes Society</h4>
                        <p class="text-xs text-gray-400 mb-3">O-, A-, B-, AB- donors are our ultimate backup line. Data kept secure for emergencies.</p>
                        <div class="flex gap-2">
                            <span class="bg-gray-800 border border-gray-600 px-2 py-1 rounded text-xs font-bold">O-</span>
                            <span class="bg-gray-800 border border-gray-600 px-2 py-1 rounded text-xs font-bold">AB-</span>
                        </div>
                    </div>
                    <div class="bg-emerald-50 border border-emerald-200 p-5 rounded-xl shadow-sm">
                        <h4 class="font-bold text-emerald-900 mb-2"><i class="fas fa-motorcycle text-emerald-600 mr-2"></i> MISTian Ride Support</h4>
                        <p class="text-xs text-emerald-700 mb-3">Need to reach the hospital fast? Request a lift from our biker community.</p>
                        <button onclick="toggleModal('rideRequestModal')" class="w-full bg-emerald-600 text-white text-sm font-bold py-2 rounded hover:bg-emerald-700">Request a Lift to Hospital</button>
                    </div>
                    
                    <!-- Dhaka Hospital Directory Area -->
                    <div class="bg-indigo-50 p-5 rounded-xl border border-indigo-100 shadow-sm">
                        <h4 class="font-bold text-indigo-900 mb-2 flex items-center gap-2"><i class="fas fa-hospital"></i> Dhaka Hospital Directory</h4>
                        <div class="flex gap-2 mb-3">
                            <input type="text" id="hospitalSearchInputHome" placeholder="e.g. CMH, DMCH, Square..." class="flex-1 p-2 text-sm border rounded outline-none focus:border-indigo-500">
                            <button onclick="searchHospital('Home')" class="bg-indigo-600 text-white px-3 py-2 rounded font-bold text-sm hover:bg-indigo-700">Find</button>
                        </div>
                        <div id="hospitalResultHome" class="hidden bg-white p-3 rounded border text-sm"></div>
                    </div>
                </div>
            </div>

            <section class="bg-white border-t py-12 mt-auto">
                <div class="max-w-7xl mx-auto px-4">
                    <h3 class="text-2xl font-bold text-center text-gray-800 mb-8"><i class="fas fa-heartbeat text-red-500 mr-2"></i> Health & Blood Donation Tips</h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="p-5 bg-gray-50 rounded-lg border hover:shadow-md transition">
                            <div class="w-10 h-10 bg-red-100 text-red-600 rounded-full flex items-center justify-center mb-3"><i class="fas fa-tint"></i></div>
                            <h4 class="font-bold text-gray-800 mb-2">Before Donation</h4>
                            <p class="text-sm text-gray-600">Drink plenty of water. Eat a healthy, iron-rich meal (avoid fatty foods). Ensure you had a good night's sleep.</p>
                        </div>
                        <div class="p-5 bg-gray-50 rounded-lg border hover:shadow-md transition">
                            <div class="w-10 h-10 bg-red-100 text-red-600 rounded-full flex items-center justify-center mb-3"><i class="fas fa-cookie-bite"></i></div>
                            <h4 class="font-bold text-gray-800 mb-2">After Donation</h4>
                            <p class="text-sm text-gray-600">Rest for 10-15 mins. Drink extra liquids for the next 24 hours. Avoid heavy physical exercise for the rest of the day.</p>
                        </div>
                        <div class="p-5 bg-gray-50 rounded-lg border hover:shadow-md transition">
                            <div class="w-10 h-10 bg-red-100 text-red-600 rounded-full flex items-center justify-center mb-3"><i class="fas fa-calendar-check"></i></div>
                            <h4 class="font-bold text-gray-800 mb-2">Eligibility</h4>
                            <p class="text-sm text-gray-600">You must weigh at least 50 kg, be free from cold/fever, and wait at least 4 months (120 days) since your last donation.</p>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- ================= PAGE 2: PORTAL ================= -->
        <div id="portal" class="page flex-grow w-full py-8 px-4 max-w-7xl mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                <div class="lg:col-span-4 space-y-6">
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden relative">
                        <div class="h-24 bg-gradient-to-r from-red-500 to-red-700 relative">
                            <button onclick="toggleModal('editProfileModal')" class="absolute top-3 right-3 bg-white/20 hover:bg-white/40 text-white p-2 rounded-full backdrop-blur-sm transition"><i class="fas fa-pen"></i></button>
                        </div>
                        <div class="px-6 pb-6 relative text-center">
                            <div class="relative inline-block -mt-12 mb-3">
                                <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-1.2.1&auto=format&fit=crop&w=150&q=80" class="w-28 h-28 rounded-full border-4 border-white shadow-md object-cover relative z-10">
                                <div id="socialFrame" class="absolute inset-0 z-20 profile-frame hidden pointer-events-none scale-110"></div>
                            </div>
                            <h2 class="text-2xl font-extrabold text-gray-900">Akib Ahmed</h2>
                            <p class="text-sm font-bold text-gray-500 uppercase tracking-widest mt-1">NSE (Batch 10)</p>
                            <div class="flex justify-center gap-2 mt-2">
                                <span class="bg-red-100 text-red-700 px-3 py-1 rounded-full text-xs font-bold border border-red-200">A+ Group</span>
                                <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs font-bold border border-green-200"><i class="fas fa-check-circle"></i> Verified</span>
                            </div>
                            <div class="mt-5 pt-4 border-t border-gray-100 text-left">
                                <h4 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">Availability Status</h4>
                                <label class="flex justify-between items-center mb-2 cursor-pointer group">
                                    <div class="flex items-center gap-2"><i class="fas fa-book-open text-indigo-500 w-4"></i> <span class="text-sm font-semibold text-gray-700 group-hover:text-indigo-600 transition">Exam Mode (Pause)</span></div>
                                    <div class="relative inline-block w-10 mr-2 align-middle select-none"><input type="checkbox" class="toggle-checkbox absolute block w-5 h-5 rounded-full bg-white border-4 appearance-none cursor-pointer z-10"/><label class="toggle-label block overflow-hidden h-5 rounded-full bg-gray-300 cursor-pointer"></label></div>
                                </label>
                                <label class="flex justify-between items-center mb-2 cursor-pointer group">
                                    <div class="flex items-center gap-2"><i class="fas fa-bus text-orange-500 w-4"></i> <span class="text-sm font-semibold text-gray-700 group-hover:text-orange-600 transition">Out of Dhaka</span></div>
                                    <div class="relative inline-block w-10 mr-2 align-middle select-none"><input type="checkbox" class="toggle-checkbox absolute block w-5 h-5 rounded-full bg-white border-4 appearance-none cursor-pointer z-10"/><label class="toggle-label block overflow-hidden h-5 rounded-full bg-gray-300 cursor-pointer"></label></div>
                                </label>
                                <label class="flex justify-between items-center cursor-pointer group">
                                    <div class="flex items-center gap-2"><i class="fas fa-thermometer-half text-red-500 w-4"></i> <span class="text-sm font-semibold text-gray-700 group-hover:text-red-600 transition">Sick / Unwell</span></div>
                                    <div class="relative inline-block w-10 mr-2 align-middle select-none"><input type="checkbox" class="toggle-checkbox absolute block w-5 h-5 rounded-full bg-white border-4 appearance-none cursor-pointer z-10"/><label class="toggle-label block overflow-hidden h-5 rounded-full bg-gray-300 cursor-pointer"></label></div>
                                </label>
                                <p class="text-[10px] text-gray-400 mt-2"><i class="fas fa-info-circle"></i> Turning any of these ON hides you from search lists.</p>
                            </div>
                            <button onclick="toggleFrame()" class="mt-4 w-full bg-indigo-50 hover:bg-indigo-100 text-indigo-700 py-2 rounded-lg text-sm font-bold border border-indigo-200 transition"><i class="fas fa-camera-retro mr-1"></i> Use "Donor Frame"</button>
                        </div>
                    </div>
                    <div class="bg-gradient-to-br from-purple-800 to-purple-900 rounded-2xl p-6 text-white shadow-lg relative overflow-hidden">
                        <div class="absolute -right-4 -bottom-4 opacity-20 text-8xl"><i class="fas fa-gem"></i></div>
                        <h3 class="text-sm font-bold text-purple-200 uppercase tracking-widest mb-1">Karma Points</h3>
                        <div class="flex items-baseline gap-2 mb-2"><h2 class="text-4xl font-black text-yellow-400">750</h2><span class="text-sm text-purple-300 font-bold">pts</span></div>
                        <p class="text-xs text-purple-200 mb-4">Earned by donating blood (500), sharing frame (50) & bike lifts (200).</p>
                        <button onclick="toggleModal('rewardStoreModal')" class="w-full bg-yellow-400 text-purple-900 py-2 rounded-lg text-sm font-bold shadow-md hover:bg-yellow-300 transition"><i class="fas fa-store mr-1"></i> Open Reward Store</button>
                    </div>
