    <div id="toast" class="hidden fixed bottom-5 left-1/2 transform -translate-x-1/2 bg-gray-900 text-white px-6 py-3 rounded-full shadow-2xl flex items-center gap-3 z-[200]">
        <i class="fas fa-check-circle text-green-400"></i><span id="toastMsg" class="font-medium">Success!</span>
    </div>

    <!-- Scripts -->
    <script>
        // SPA Navigation Logic
        function nav(pageId) {
            document.querySelectorAll('.page').forEach(p => { p.classList.remove('active'); setTimeout(() => p.style.display = 'none', 300); });
            setTimeout(() => {
                const target = document.getElementById(pageId);
                target.style.display = 'flex';
                setTimeout(() => target.classList.add('active'), 10);
            }, 300);
            window.scrollTo(0,0);
            if(pageId === 'home') startAutoScroll(); else stopAutoScroll();
        }

        // View Live Request Details
        function viewRequest(id) { nav('request'); }

        function toggleModal(id) { document.getElementById(id).classList.toggle('hidden'); }
        function closeSearch(id) { document.getElementById(id).classList.add('hidden'); }
        
        function showToast(msg) {
            const t = document.getElementById('toast');
            document.getElementById('toastMsg').innerText = msg;
            t.classList.remove('hidden');
            setTimeout(() => t.classList.add('hidden'), 3500);
        }

        function toggleFrame() {
            const frame = document.getElementById('socialFrame');
            frame.classList.toggle('hidden');
            if(!frame.classList.contains('hidden')) showToast("Profile Frame Applied!");
        }

        function generateStory() { document.getElementById('storyToast').classList.remove('hidden'); }
        function copyLink() { showToast("Link copied to clipboard!"); }

        function toggleFAQ(answerId, iconId) {
            const answer = document.getElementById(answerId);
            const icon = document.getElementById(iconId);
            if (answer.classList.contains('open')) {
                answer.classList.remove('open');
                icon.classList.remove('rotate-180');
            } else {
                document.querySelectorAll('.faq-answer').forEach(el => el.classList.remove('open'));
                document.querySelectorAll('.fa-chevron-down').forEach(el => el.classList.remove('rotate-180'));
                answer.classList.add('open');
                icon.classList.add('rotate-180');
            }
        }

        // Hero Auto Scroll
        const scrollContainer = document.getElementById('heroScroll');
        let scrollInterval;
        function startAutoScroll() {
            if(!scrollInterval && scrollContainer) {
                scrollInterval = setInterval(() => {
                    scrollContainer.scrollLeft += 1; 
                    if(scrollContainer.scrollLeft >= (scrollContainer.scrollWidth - scrollContainer.clientWidth - 1)) scrollContainer.scrollLeft = 0;
                }, 30);
            }
        }
        function stopAutoScroll() { clearInterval(scrollInterval); scrollInterval = null; }
        if(scrollContainer) {
            startAutoScroll();
            scrollContainer.addEventListener('mouseenter', stopAutoScroll);
            scrollContainer.addEventListener('mouseleave', startAutoScroll);
            scrollContainer.addEventListener('touchstart', stopAutoScroll);
            scrollContainer.addEventListener('touchend', startAutoScroll);
        }

        // Data & Rendering
        let posts = [
            { id: 105, blood: 'O+', bags: 2, date: '2026-08-20', urgency: 'Needed in 1/2 days', problem: 'Bypass Surgery', hospital: 'CMH, Dhaka', relation: 'Father', transportProvided: true },
            { id: 106, blood: 'AB-', bags: 1, date: '2026-08-18', urgency: 'Urgent (Today)', problem: 'Road Accident', hospital: 'Evercare Hospital', relation: 'Relative', transportProvided: false }
        ];

        const hospitals = [
            { name: "CMH (Combined Military Hospital)", address: "Dhaka Cantonment", landmark: "Inside Cantonment, entry via Jahangir Gate." },
            { name: "DMCH (Dhaka Medical College)", address: "Secretariat Road", landmark: "Beside Central Shaheed Minar." },
            { name: "Square Hospitals", address: "Panthapath", landmark: "Near Bashundhara City." }
        ];

        const dummyDonors = { 'A+': ['Akib Ahmed_NSE_10'], 'B+': ['Tanvir Hasan_ME_19'], 'O+': ['Mahmudul_CE_22'] };

        function renderPosts() {
            const container = document.getElementById('feedContainer');
            if(!container) return;
            container.innerHTML = '';
            posts.forEach(post => {
                const urgencyColor = post.urgency.includes('Urgent') ? 'text-red-600 bg-red-100' : 'text-orange-600 bg-orange-100';
                const transportBadge = post.transportProvided ? `<p class="text-xs text-blue-600 font-bold mb-2 bg-blue-50 inline-block px-2 py-1 rounded"><i class="fas fa-car mr-1"></i> Transport cost will be provided</p>` : '';
                container.innerHTML += `
                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition relative mt-4">
                        <div class="absolute top-0 right-0 ${urgencyColor} text-xs font-bold px-3 py-1 rounded-bl-lg">${post.urgency}</div>
                        <div class="p-5 flex flex-col md:flex-row gap-5 mt-4">
                            <div class="flex-shrink-0 flex flex-col items-center justify-center bg-gray-50 w-24 h-24 rounded-xl border border-gray-200 shadow-sm"><span class="text-3xl font-black text-red-600">${post.blood}</span><span class="text-xs font-bold text-gray-500 mt-1">${post.bags} Bag(s)</span></div>
                            <div class="flex-grow">${transportBadge}<h4 class="text-lg font-bold text-gray-800 mb-1 flex items-center gap-2"><i class="fas fa-hospital-alt text-red-500"></i>${post.hospital}</h4><p class="text-sm font-bold text-gray-700 mb-3 border-b pb-2">Problem: <span class="font-normal text-red-600">${post.problem}</span></p><div class="grid grid-cols-2 gap-y-2 text-sm text-gray-600"><p><i class="far fa-calendar-alt w-5 text-gray-400"></i> Date: <span class="font-semibold text-gray-800">${post.date}</span></p><p><i class="fas fa-user-injured w-5 text-gray-400"></i> For: <span class="font-semibold text-gray-800">${post.relation}</span></p></div></div>
                        </div>
                        <div class="bg-gray-50 px-5 py-3 border-t flex justify-end">
                            <button onclick="viewRequest(${post.id})" class="bg-red-600 text-white px-6 py-2 rounded-md font-bold text-sm shadow hover:bg-red-700 transition flex items-center gap-2"><i class="fas fa-hand-holding-medical"></i> View & Donate</button>
                        </div>
                    </div>
                `;
            });
        }

        function handlePostSubmit(e) {
            e.preventDefault();
            posts.unshift({
                id: Date.now(), blood: document.getElementById('reqBlood').value, bags: document.getElementById('reqBags').value, date: document.getElementById('reqDate').value, urgency: document.getElementById('reqUrgency').value, problem: document.getElementById('reqProblem').value, hospital: document.getElementById('reqHospital').value, relation: document.getElementById('reqRelation').value, transportProvided: document.getElementById('reqTransportProvider').checked
            });
            toggleModal('postModal'); e.target.reset(); renderPosts(); showToast("Blood request posted successfully.");
        }

        function searchDonors() {
            const group = document.getElementById('searchGroup').value;
            if(!group) return showToast("Select a blood group first.");
            document.getElementById('searchResults').classList.remove('hidden');
            document.getElementById('searchResultTitle').innerHTML = `Available <span class="text-red-600 font-black ml-1">${group}</span> Donors`;
            const list = document.getElementById('donorList'); list.innerHTML = '';
            const donorsList = dummyDonors[group] || [];
            if(donorsList.length === 0) { list.innerHTML = `<li class="text-gray-500 text-sm text-center py-4">No eligible donors found.</li>`; } 
            else {
                donorsList.forEach(d => {
                    const [name, dept, batch] = d.split('_');
                    list.innerHTML += `<li class="flex justify-between items-center bg-gray-50 p-3 rounded-lg border"><div><p class="font-bold text-gray-800">${name}</p><div class="flex gap-2 text-xs font-semibold mt-1"><span class="bg-blue-100 text-blue-700 px-2 py-0.5 rounded">Dept: ${dept}</span></div></div><button onclick="showToast('Notification sent!')" class="text-sm bg-red-100 text-red-600 px-3 py-1.5 rounded font-bold hover:bg-red-200">Notify</button></li>`;
                });
            }
        }

        // Updated Hospital Search logic
        function searchHospital(context) { 
            const inputId = context === 'Home' ? 'hospitalSearchInputHome' : 'hospitalSearchInput';
            const resultId = context === 'Home' ? 'hospitalResultHome' : 'hospitalResult';
            
            const query = document.getElementById(inputId).value.toLowerCase();
            const resultDiv = document.getElementById(resultId);
            
            if(!query) {
                resultDiv.classList.add('hidden');
                return;
            }
            
            const match = hospitals.find(h => h.name.toLowerCase().includes(query) || h.address.toLowerCase().includes(query));
            resultDiv.classList.remove('hidden');
            
            if(match) {
                resultDiv.innerHTML = `<h5 class="font-bold text-gray-800 border-b pb-1 mb-2">${match.name}</h5><p class="text-gray-600 text-xs mb-1"><strong>Address:</strong> ${match.address}</p><p class="text-gray-600 text-xs"><strong>Landmark:</strong> ${match.landmark}</p>`;
            } else {
                resultDiv.innerHTML = `<p class="text-gray-500 text-center py-2 text-sm">No matching hospital found in directory.</p>`;
            }
        }

        renderPosts();
    </script>
</body>
